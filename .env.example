# 本地模型（vLLM OpenAI-compatible）
LOCAL_BASE_URL=http://your-vllm-host:8000/v1
LOCAL_MODEL_NAME=Qwen3.5-27B

# 远端模型提供商：qwen | deepseek | openai | custom
REMOTE_PROVIDER=qwen

# 可选：覆盖所选提供商的默认 base URL（OpenAI 兼容端点）
# REMOTE_BASE_URL=https://your-proxy.example.com/v1

# --- Qwen (DashScope) ---
QWEN_API_KEY=sk-xxxxxxxxxxxxxxxx
QWEN_MODEL_NAME=qwen-max

# --- DeepSeek ---
# DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxx
# DEEPSEEK_MODEL_NAME=deepseek-v4-pro

# --- OpenAI ---
# OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxx
# OPENAI_MODEL_NAME=gpt-4o-mini

# --- 自定义 OpenAI 兼容 API ---
# REMOTE_PROVIDER=custom
# CUSTOM_BASE_URL=https://your-api.example.com/v1
# CUSTOM_API_KEY=sk-xxxxxxxxxxxxxxxx
# CUSTOM_MODEL_NAME=your-model-name

# 路由阈值：涉及表的行数超过此值则使用远端模型
ROW_THRESHOLD=10000

# seed 数据量缩放（1.0=全量，0.1=快速开发）
SEED_SCALE=1.0

# LLM 请求超时（毫秒）
LLM_TIMEOUT_MS=60000

# 服务端口
SERVER_PORT=3000
