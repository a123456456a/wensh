# 本地模型（vLLM OpenAI-compatible）
LOCAL_BASE_URL=http://your-vllm-host:8000/v1
LOCAL_MODEL_NAME=Qwen3.5-27B

# 远端模型提供商：qwen | deepseek | openai | custom
REMOTE_PROVIDER=deepseek

# 可选：覆盖所选提供商的默认 base URL（OpenAI 兼容端点）
# REMOTE_BASE_URL=https://your-proxy.example.com/v1

# --- Qwen (DashScope) ---
QWEN_API_KEY=sk-xxxxxxxxxxxxxxxx
QWEN_MODEL_NAME=qwen-max

# --- DeepSeek ---
# DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxx
# DEEPSEEK_MODEL_NAME=deepseek-v4-pro

# --- OpenAI ---
# OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxx
# OPENAI_MODEL_NAME=gpt-4o-mini

# --- 自定义 OpenAI 兼容 API ---
# REMOTE_PROVIDER=custom
# CUSTOM_BASE_URL=https://your-api.example.com/v1
# CUSTOM_API_KEY=sk-xxxxxxxxxxxxxxxx
# CUSTOM_MODEL_NAME=your-model-name

# 路由阈值：涉及表的行数超过此值则使用远端模型
ROW_THRESHOLD=10000

# 模型路由模式：rule=仅规则 | llm=仅 Router LLM | hybrid=方案B（规则高置信 + 低置信 LLM）
ROUTER_MODE=hybrid
# Router LLM 超时（毫秒）
ROUTER_TIMEOUT_MS=15000
# Router 优先使用本地模型（false 则 Router 也走远端）
ROUTER_USE_LOCAL=true

# 分阶段模型协作：true=SQL 生成走路由模型，结果解读强制走云端
# 默认 false（解读与 SQL 使用同一模型）；需同时配置可用的云端 API Key
SPLIT_MODEL_INTERPRET=false

# seed 数据量缩放（1.0=全量，0.1=快速开发）
SEED_SCALE=1.0

# LLM 请求超时（毫秒）
LLM_TIMEOUT_MS=60000

# 服务端口
SERVER_PORT=3000

# --- 多业务域 Data API ---
# 默认业务域（前端初始选中，可选 demo | mes | mro）
DEFAULT_DOMAIN=demo

# MES 域 API（未配置时前端/health 标记为不可用）
MES_DATA_API_URL=https://mes-api.internal.example.com
MES_DOMAIN_LABEL=制造执行

# MRO 域 API
MRO_DATA_API_URL=https://mro-api.internal.example.com
MRO_DOMAIN_LABEL=设备维护

# 问数 BFF 调用域 API 的服务 Token（不下发浏览器）
DOMAIN_API_TOKEN=your-service-token
DOMAIN_API_TIMEOUT_MS=30000

# --- 认证（P4）---
# true=需登录后问数；false=开发免登录
AUTH_ENABLED=true
AUTH_PROVIDER=local
WEB_ORIGIN=http://localhost:5173
SESSION_SECRET=change-me-in-production
SESSION_MAX_AGE_MS=86400000
WENSH_DOMAIN_SIGNING_SECRET=shared-with-domain-api-teams

MES_DATA_API_TOKEN=mes-service-token
MRO_DATA_API_TOKEN=mro-service-token

# V2 企业 SSO（后期启用）
# AUTH_PROVIDER=oidc
# OIDC_ISSUER=https://sso.company.com
# OIDC_CLIENT_ID=
# OIDC_CLIENT_SECRET=
# OIDC_REDIRECT_URI=http://localhost:5173/api/auth/oidc/callback
